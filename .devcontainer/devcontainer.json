{
  "name": "PocketKid Development",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "features": {
    "ghcr.io/devcontainers/features/node:2": {
      "version": "lts"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "workspaceFolder": "/workspace/pocketkid",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace/pocketkid,type=bind",
  "mounts": [
  "source=pocketkid-bash-history,target=/home/vscode/.bash-history,type=volume",
  "source=pocketkid-vscode-user-data,target=/home/vscode/.vscode-server/data/User,type=volume",
  "source=pocketkid-copilot-sessions,target=/home/vscode/.vscode-server/data/agentSessionData,type=volume",
  "source=pocketkid-copilot-chats,target=/home/vscode/.copilot/chats,type=volume",
  "source=pocketkid-copilot-session-state,target=/home/vscode/.copilot/session-state,type=volume"
  ],
  "forwardPorts": [
    8000
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "donjayamanne.githistory",
        "mhutchie.git-graph"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python"
      }
    }
  },
  "remoteUser": "vscode",
  "remoteEnv": {
    "HISTFILE": "/home/vscode/.bash-history/history"
  }
}