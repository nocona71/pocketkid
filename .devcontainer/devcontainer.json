{
  "name": "PocketKid Development",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/node:2": {
      "version": "lts"
    }
  },
  "workspaceFolder": "/workspace/pocketkid",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace/pocketkid,type=bind",
  "postCreateCommand": "pip install -r requirements.txt",
  "forwardPorts": [
    8000
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python"
      }
    }
  },
  "remoteUser": "vscode"
}